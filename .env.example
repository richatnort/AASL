# Google OAuth — create two clients at console.cloud.google.com:
#   Dev:  redirect URI = http://localhost:3001/auth/google/callback
#   Prod: redirect URI = https://your-domain.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Session — rotate this if it ever leaks (all users get logged out on restart)
SESSION_SECRET=change-me-to-a-long-random-string

# Admin — on first OAuth login, this email gets approved=true and is_admin=true automatically
ADMIN_EMAIL=

# Pre-approved users — comma-separated emails that get approved=true automatically on first login (not admin)
PRE_APPROVED_EMAILS=

# Database — update DB_PASSWORD before deploying to prod
DATABASE_URL=postgres://shopping:shopping@localhost:5432/shopping

# Alexa service — optional, only needed if you're running the Alexa integration
ALEXA_SERVICE_URL=

# Ollama — optional local LLM fallback for recipe parsing (defaults to localhost:11434)
OLLAMA_HOST=http://localhost:11434

# App
PORT=3001
NODE_ENV=development
